 #include "qt_config.h"
 #include "uisettings.h"
 
+namespace {
+// Written for a mapping the user cleared on purpose. An empty value means "not saved yet" and is
+// replaced by the default key on load, so a cleared command needs its own marker to stay empty.
+constexpr char ClearedMappingMarker[] = "[empty]";
+
+std::string ToSavedMapping(const std::string& value) {
+    return value.empty() ? std::string(ClearedMappingMarker) : value;
+}
+
+void FromSavedMapping(std::string& value, const std::string& default_param) {
+    if (value == ClearedMappingMarker) {
+        value.clear();
+    } else if (value.empty()) {
+        value = default_param;
+    }
+}
+} // namespace
