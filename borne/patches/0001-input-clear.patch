+void ConfigureInputPlayer::ClearAnalogDirection(int analog_id, int sub_button_id) {
+    Common::ParamPackage param = emulated_controller->GetStickParam(analog_id);
+    if (param.Get("engine", "") != "analog_from_button") {
+        // A real stick is mapped as a whole: clearing one direction clears the stick.
+        emulated_controller->SetStickParam(analog_id, {});
+        return;
+    }
+    static constexpr std::array<const char*, 4> directions{"up", "down", "left", "right"};
+    if (sub_button_id >= 0 && sub_button_id < static_cast<int>(directions.size())) {
+        param.Erase(directions[sub_button_id]);
+    }
+    emulated_controller->SetStickParam(analog_id, param);
+}
